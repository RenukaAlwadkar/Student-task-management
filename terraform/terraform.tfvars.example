# ==============================================================================
# Sample Terraform Variables Configuration File
# Copy this file to 'terraform.tfvars' and supply your credentials:
#   cp terraform.tfvars.example terraform.tfvars
#
# DO NOT COMMIT terraform.tfvars TO GIT (It is excluded in .gitignore)
# ==============================================================================

# Your 32-character Cloudflare Account ID
# Found at: Cloudflare Dashboard -> Workers & Pages (Overview right sidebar)
cloudflare_account_id = "your_cloudflare_account_id_here"

# Your Cloudflare API Token
# Create at: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token
# Permissions required:
#   - Account | Workers Scripts | Edit
#   - Account | Workers KV Storage | Edit
cloudflare_api_token = "your_cloudflare_api_token_here"

# Application Configuration
worker_name        = "student-task-manager"
kv_namespace_name  = "student_tasks"
environment        = "production"
enable_subdomain   = true
